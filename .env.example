# 로컬 개발 설정. 복사해서 .env로 쓴다.
# .env는 커밋하지 않는다 (.gitignore).

DATABASE_URL=postgres://buildfit:buildfit@localhost:5432/buildfit

# BuildCores OpenDB clone 경로 (ADR-0002).
# git clone --depth 1 https://github.com/buildcores/buildcores-open-db
# 레포 안에 두지 않는다 — .gitignore에서 제외되어 있다.
OPENDB_PATH=../buildcores-open-db

# 어드민 공유 비밀 (ADR-0020). 16자 이상.
# 비워 두면 개발 환경에서는 그냥 열리고, 배포본에서는 /admin이 404가 된다.
# 계정이 아니라 비밀 하나다 — 브라우저가 물으면 아이디 칸은 비우고 이 값만 넣는다.
#   ADMIN_TOKEN=$(openssl rand -base64 24)
ADMIN_TOKEN=
